rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo tú puedes leer y escribir tus datos
    // Cambia "kaenriquezt@gmail.com" por tu email real de Google
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.token.email == "TU_EMAIL@gmail.com";
    }
  }
}
